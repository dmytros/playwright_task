# Secrets
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Optional: reuse a previous login (helps with 2FA)
LINKEDIN_STORAGE_STATE=./.linkedin_storage.json

# 1 = like feed | 2 = draft comments | 3 = profile-aware drafts (optional)
LINKEDIN_LEVEL=2
LINKEDIN_HEADLESS=false

LINKEDIN_BASE_URL=https://www.linkedin.com
LINKEDIN_INTERESTS=engineering,architecture,product,leadership,ai,career

# Level 2/3 only — drafts are never posted
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2
